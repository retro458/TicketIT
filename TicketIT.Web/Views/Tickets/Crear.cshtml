@model TicketIT.Web.ViewModels.Tickets.CrearTicketViewModel
@{ ViewData["Title"] = "Nuevo Ticket"; }

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Crear Nuevo Ticket</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label fw-semibold">Título</label>
                        <input asp-for="Titulo" class="form-control" placeholder="Describe brevemente el problema" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="4"
                            placeholder="Detalla el problema, pasos para reproducirlo, capturas, etc."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PrioridadId" class="form-label fw-semibold">Prioridad</label>
                            <select asp-for="PrioridadId" asp-items="Model.Prioridades" class="form-select">
                                <option value="">— Selecciona —</option>
                            </select>
                            <span asp-validation-for="PrioridadId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoriaId" class="form-label fw-semibold">Categoría</label>
                            <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
                                <option value="">— Selecciona —</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send"></i> Enviar Ticket
                        </button>
                        <a asp-action="MisTickets" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>